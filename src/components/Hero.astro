---
import { heroImage as resolveImage, heroVideos } from "../lib/heroMedia";
import type { HeroImage, HeroVideo } from "../types/HeroMedia";

interface Props {
  image?: string;
  alt?: string;
  scrollTarget?: string;
  heroImage?: HeroImage | null;
  heroVideo?: HeroVideo | null;
  mobileHeroImage?: HeroImage | null;
  mobileHeroVideo?: HeroVideo | null;
}

const { image = "", alt = "", scrollTarget = "", heroImage,
  heroVideo, mobileHeroImage, mobileHeroVideo } = Astro.props;
const desktopImage = resolveImage(heroImage, image);
const mobileImage = resolveImage(mobileHeroImage, desktopImage.url);
// A missing mobile image must inherit the desktop focal position as well.
const mobilePosition = mobileHeroImage?.asset?.url ? mobileImage.position : desktopImage.position;
const videos = heroVideos(heroVideo, mobileHeroVideo, Boolean(mobileHeroImage?.asset?.url));
const hasVideo = Boolean(videos.desktop || videos.mobile);
---

<section
  class="relative overflow-hidden w-full bg-white bg-cover bg-center bg-blend-color-burn h-screen flex items-center justify-center mb-32"
  style={`--hero-position: ${desktopImage.position}; --mobile-hero-position: ${mobilePosition};`}
  id="hero"
  data-hero-media
  data-desktop-video={videos.desktop || undefined}
  data-mobile-video={videos.mobile || undefined}
>
  {(desktopImage.url || mobileImage.url) && (
    <picture class="hero-picture absolute inset-0 block">
      {mobileImage.url && <source media="(max-width: 767.98px)" srcset={mobileImage.url} />}
      <img
        src={desktopImage.url || mobileImage.url}
        alt={alt}
        class="hero-still w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  )}
  {hasVideo && (
    <>
      {/* Native source selection starts the appropriate video before JS initialises. */}
      <video
        class="hero-video absolute inset-0 w-full h-full object-cover opacity-0 pointer-events-none transition-opacity duration-300 motion-reduce:transition-none"
        muted loop playsinline preload="auto" aria-hidden="true" tabindex="-1"
      >
        {videos.desktop && <source src={videos.desktop} media="(min-width: 768px) and (prefers-reduced-motion: no-preference)" />}
        {videos.mobile && <source src={videos.mobile} media="(max-width: 767.98px) and (prefers-reduced-motion: no-preference)" />}
      </video>
      <button
        type="button"
        data-hero-playback
        hidden
        class="absolute z-10 bottom-6 left-6 md:bottom-12 md:left-12 rounded bg-black/70 px-4 py-2 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
        aria-label="Play background video"
      >Play video</button>
    </>
  )}
  <a
    href={`#${scrollTarget}`}
    class="absolute bottom-6 md:bottom-12 right-6 md:right-12"
    data-target={scrollTarget}
  >
    <!-- <ChevronDown class="animate-bounce w-16 text-white" /> -->
  </a>
</section>

<style>
  .hero-still { object-position: var(--hero-position); }
  .hero-video { object-position: center; }
  /* Keep the responsive photograph beneath the video throughout its fade-in. */
  @media (max-width: 767.98px) {
    .hero-still { object-position: var(--mobile-hero-position); }
  }
</style>

<noscript>
  <style is:inline>
    #hero .hero-picture { display: block !important; }
    #hero .hero-video { display: none; }
  </style>
</noscript>

<script>
  import { initHeroVideo } from "../scripts/hero-video";

  function initSmoothScroll() {
    const hero = document.querySelector<HTMLElement>("[data-hero-media]");
    if (hero) initHeroVideo(hero);
    const targetId = document
      .querySelector("a[data-target]")
      ?.getAttribute("data-target");
    let fired = false;

    function smoothJump() {
      if (targetId) {
        const el = document.getElementById(targetId);
        if (el) el.scrollIntoView({ behavior: "smooth" });
      }
    }

    function onScroll() {
      const y = window.scrollY;

      if (!fired && y > 10) {
        fired = true;
        smoothJump();
      }

      if (fired && y < 10) {
        fired = false;
      }
    }

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("scroll", onScroll);
      fired = false;
    });
  }

  // Run on initial load
  initSmoothScroll();

  // Re-run on client-side navigation
  document.addEventListener("astro:page-load", initSmoothScroll);
</script>
