---
import { Picture, getImage } from "astro:assets";
import type { GetImageResult } from "astro";

interface Slide {
  alt: string;
  image: any;
  mobileImage?: any;
  mobileObjectClass?: string;
  widths?: number[];
  formats?: ("avif" | "webp" | "jpg")[];
  quality?: number;
  code: string;
  title: string;
}

interface Props {
  slides: Slide[];
}

const { slides = [] } = Astro.props;
const hasMultipleSlides = slides.length > 1;
const slideSizes = "100vw";
const defaultSlideWidths = [640, 960, 1280, 1600, 1920];

type ResponsiveSource = {
  media: string;
  type: string;
  srcset: string;
};

type PreparedSlide =
  | (Slide & {
      variant: "single";
    })
  | (Slide & {
      variant: "responsive";
      responsiveSources: ResponsiveSource[];
      fallbackImage: GetImageResult;
    });

const slidePictures = await Promise.all(
  slides.map(async (slide) => {
    const slideWidths = slide.widths ?? defaultSlideWidths;
    const slideQuality = slide.quality;
    if (!slide.mobileImage) {
      return {
        ...slide,
        variant: "single",
      } satisfies PreparedSlide;
    }

    const [
      mobileAvif,
      mobileWebp,
      desktopAvif,
      desktopWebp,
      fallbackImage,
    ] = await Promise.all([
      getImage({
        src: slide.mobileImage,
        format: "avif",
        widths: slideWidths,
        sizes: slideSizes,
        quality: slideQuality,
      }),
      getImage({
        src: slide.mobileImage,
        format: "webp",
        widths: slideWidths,
        sizes: slideSizes,
        quality: slideQuality,
      }),
      getImage({
        src: slide.image,
        format: "avif",
        widths: slideWidths,
        sizes: slideSizes,
        quality: slideQuality,
      }),
      getImage({
        src: slide.image,
        format: "webp",
        widths: slideWidths,
        sizes: slideSizes,
        quality: slideQuality,
      }),
      getImage({
        src: slide.image,
        widths: slideWidths,
        sizes: slideSizes,
        quality: slideQuality,
      }),
    ]);

    return {
      ...slide,
      variant: "responsive",
      responsiveSources: [
        {
          media: "(max-width: 767px)",
          type: "image/avif",
          srcset: mobileAvif.srcSet.attribute,
        },
        {
          media: "(max-width: 767px)",
          type: "image/webp",
          srcset: mobileWebp.srcSet.attribute,
        },
        {
          media: "(min-width: 768px)",
          type: "image/avif",
          srcset: desktopAvif.srcSet.attribute,
        },
        {
          media: "(min-width: 768px)",
          type: "image/webp",
          srcset: desktopWebp.srcSet.attribute,
        },
      ],
      fallbackImage,
    } satisfies PreparedSlide;
  }),
);
---

<section
  class="absolute inset-0 overflow-hidden bg-white"
  data-holding-slideshow
  data-slide-count={slides.length}
>
  {
    slidePictures.map((slide, index) => (
      <div
        class={`absolute inset-0 ${index === 0 ? "opacity-100" : "opacity-0"} ${hasMultipleSlides ? "transition-opacity duration-700 ease-out motion-reduce:transition-none" : ""}`}
        data-slide
        data-slide-index={index}
        aria-hidden={index === 0 ? "false" : "true"}
      >
        {
          slide.variant === "responsive" ? (
            <picture>
              {slide.responsiveSources.map((source: ResponsiveSource) => (
                <source
                  srcset={source.srcset}
                  sizes={slideSizes}
                  media={source.media}
                  type={source.type}
                />
              ))}
              <img
                src={slide.fallbackImage.src}
                srcset={slide.fallbackImage.srcSet.attribute}
                sizes={slideSizes}
                width={slide.fallbackImage.attributes.width}
                height={slide.fallbackImage.attributes.height}
                alt={slide.alt}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={index === 0 ? "high" : "auto"}
                class={`h-full w-full object-cover ${slide.mobileObjectClass ?? ""}`}
              />
            </picture>
          ) : (
            <Picture
              src={slide.image}
              alt={slide.alt}
              formats={slide.formats ?? ["avif", "webp"]}
              widths={slide.widths ?? defaultSlideWidths}
              sizes={slideSizes}
              quality={slide.quality}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "auto"}
              class={`h-full w-full object-cover ${slide.mobileObjectClass ?? ""}`}
            />
          )
        }
      </div>
    ))
  }

  {
    hasMultipleSlides && (
      <div class="absolute bottom-4 right-4 z-20 flex items-center justify-end gap-2 md:bottom-6 md:right-6">
        {slides.map((_, index) => (
          <button
            type="button"
            class={`h-[3px] bg-white/55 transition-all duration-500 ${index === 0 ? "w-8 bg-white" : "w-4"}`}
            data-slide-indicator
            data-slide-indicator-index={index}
            aria-label={`Show slide ${index + 1}`}
          ></button>
        ))}
      </div>
    )
  }
</section>

{
  hasMultipleSlides && (
    <script is:inline>
      const initHoldingSlideshow = () => {
        const root = document.querySelector("[data-holding-slideshow]");
        if (!root) return;

        const slides = Array.from(root.querySelectorAll("[data-slide]"));
        const indicators = Array.from(
          root.querySelectorAll("[data-slide-indicator]")
        );
        const slideMeta = Array.from(
          document.querySelectorAll("[data-slide-meta]")
        );
        if (slides.length <= 1) return;

        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        );

        let currentIndex = 0;
        let timerId = null;
        let isManuallyLocked = false;

        const setActiveSlide = (index) => {
          slides.forEach((slide, slideIndex) => {
            const isActive = slideIndex === index;
            slide.classList.toggle("opacity-100", isActive);
            slide.classList.toggle("opacity-0", !isActive);
            slide.setAttribute("aria-hidden", String(!isActive));
          });

          indicators.forEach((indicator, indicatorIndex) => {
            const isActive = indicatorIndex === index;
            indicator.classList.toggle("w-8", isActive);
            indicator.classList.toggle("w-4", !isActive);
            indicator.classList.toggle("bg-white", isActive);
            indicator.classList.toggle("bg-white/55", !isActive);
          });

          slideMeta.forEach((meta, metaIndex) => {
            const isActive = metaIndex === index;
            meta.classList.toggle("opacity-100", isActive);
            meta.classList.toggle("opacity-0", !isActive);
            meta.classList.toggle("pointer-events-none", !isActive);
            meta.setAttribute("aria-hidden", String(!isActive));
          });
        };

        const stop = () => {
          if (timerId) {
            window.clearInterval(timerId);
            timerId = null;
          }
        };

        const start = () => {
          stop();
          if (isManuallyLocked) return;
          if (prefersReducedMotion.matches) {
            setActiveSlide(0);
            currentIndex = 0;
            return;
          }

          timerId = window.setInterval(() => {
            currentIndex = (currentIndex + 1) % slides.length;
            setActiveSlide(currentIndex);
          }, 9000);
        };

        setActiveSlide(0);
        start();

        root.addEventListener("mouseenter", stop);
        root.addEventListener("mouseleave", start);

        indicators.forEach((indicator, indicatorIndex) => {
          indicator.addEventListener("click", () => {
            isManuallyLocked = true;
            stop();
            currentIndex = indicatorIndex;
            setActiveSlide(indicatorIndex);
          });
        });

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            stop();
          } else {
            start();
          }
        });

        prefersReducedMotion.addEventListener?.("change", start);

        document.addEventListener(
          "astro:before-swap",
          () => {
            stop();
          },
          { once: true }
        );
      };

      if (document.readyState !== "loading") {
        initHoldingSlideshow();
      } else {
        document.addEventListener("DOMContentLoaded", initHoldingSlideshow, {
          once: true,
        });
      }

      document.addEventListener("astro:page-load", initHoldingSlideshow);
    </script>
  )
}
