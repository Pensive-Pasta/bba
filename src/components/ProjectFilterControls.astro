---
import AnimatedPills from "./AnimatedPills.astro";
const filters = [
  { value: "both", label: "All" },
  { value: "urban", label: "Urban" },
  { value: "inter-urban", label: "Inter-Urban" },
  { value: "rural", label: "Rural" },
];
---
<div class="page-grid-filters flex items-center text-lg">
  <AnimatedPills items={filters} label="Filter projects" buttonClass="filter-btn" valueAttribute="data-type" indicatorId="filter-indicator" />
  <div class="flex flex-row shrink-0 justify-end pl-2 group ml-auto">
    <button id="index-toggle" type="button" aria-controls="project-index" aria-expanded="false" aria-label="Show project index" class="border-2 border-primary rounded-full p-3 sm:border-0">
      <div
        class="text-base md:text-lg relative z-10 grid items-center justify-items-end"
      >
        <span
          id="label-index"
          aria-hidden="true"
          class="col-start-1 row-start-1 flex items-center gap-4 opacity-100 transition-opacity duration-300 ease-in-out"
        >
          <span class="hidden sm:inline text-xl">Index</span>
          <img src="/icons/Index.svg" alt="Index" class="w-6" />
        </span>
        <span
          id="label-grid"
          aria-hidden="true"
          class="col-start-1 row-start-1 flex items-center gap-4 opacity-0 transition-opacity duration-300 ease-in-out invisible"
        >
          <span class="hidden sm:inline text-xl">Grid</span>
          <img src="/icons/Grid.svg" alt="Grid" class="w-6" />
        </span>
      </div>
    </button>
  </div>
</div>
