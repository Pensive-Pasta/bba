---
import AnimatedPills from "./AnimatedPills.astro";
const filters = [
  { value: "both", label: "All" },
  { value: "urban", label: "Urban" },
  { value: "inter-urban", label: "Inter-Urban" },
  { value: "rural", label: "Rural" },
];
---
<div class="page-grid-filters flex items-center text-lg">
  <AnimatedPills items={filters} label="Filter projects" buttonClass="filter-btn" valueAttribute="data-type" indicatorId="filter-indicator" />
  <!-- Keep the Index control available for later; its bindings also initialise filtering. -->
  <div class="hidden flex-row justify-end pl-2 group ml-auto">
    <button id="index-toggle" class="border-2 border-primary rounded-full p-3 sm:border-0">
      <div
        class="text-base md:text-lg relative z-10 flex items-center gap-2 transition-opacity duration-300 ease-in-out min-w-[16px]"
      >
        <span
          id="label-index"
          class="flex items-center gap-4 opacity-100 transition-all duration-300 ease-in-out"
        >
          <span class="hidden sm:inline text-xl">Index</span>
          <img src="/icons/Index.svg" alt="Index" class="w-6" />
        </span>
      </div>
      <span
        id="label-grid"
        class="items-center gap-2 opacity-0 transition-all duration-300 ease-in-out hidden"
      >
        <div class="flex items-center gap-2">
          <span class="hidden sm:inline text-xl">Grid</span>
          <img src="/icons/Grid.svg" alt="Grid" class="w-6" />
        </div>
      </span>
    </button>
  </div>
</div>
