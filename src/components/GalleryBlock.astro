---
import { randomUUID } from "node:crypto";
import { gallerySlides } from "../lib/gallery";
import type { GalleryImage } from "../types/Gallery";

interface Props {
  images?: Array<GalleryImage | null> | null;
  heading?: string | null;
  alignment?: "left" | "right";
}

const { images, heading, alignment = "right" } = Astro.props;
const slides = gallerySlides(images);
const title = typeof heading === "string" ? heading.trim() : "";
const id = `gallery-${randomUUID()}`;
const alignmentClass = alignment === "right" ? "md:ml-auto md:mr-0" : "md:mr-auto md:ml-0";
---

{slides.length > 0 && (
  <section class={`w-full md:w-1/2 px-4 md:px-8 mb-12 ${alignmentClass}`} aria-label={title || "Image gallery"}>
    <bba-gallery>
      {title && <h2 class="text-xl md:text-2xl font-bold mb-4">{title}</h2>}
      <p id={`${id}-help`} class="sr-only">Scroll to explore photographs. Use the arrow keys when the gallery is focused, or Tab to an image and press Enter to enlarge it.</p>
      <ul id={id} class="gallery-track" data-gallery-track tabindex="0" aria-label={title || "Photographs"} aria-describedby={`${id}-help`}>
        {slides.map((slide) => (
          <li data-gallery-slide style={`--gallery-ratio:${slide.width / slide.height};--gallery-native-width:${slide.width}px;`}>
            <figure>
              <a href={slide.lightbox} data-gallery-image data-astro-reload
                data-pswp-width={slide.lightboxWidth} data-pswp-height={slide.lightboxHeight}
                data-pswp-srcset={slide.lightboxSrcset}
                aria-label={`Enlarge photograph: ${slide.alt}`}>
                <img src={slide.thumbnail} srcset={slide.srcset} sizes="auto, (min-width: 768px) 50vw, 100vw"
                  width={slide.width} height={slide.height} alt={slide.alt} loading="lazy" decoding="async" />
              </a>
              {slide.caption && <figcaption class="mt-2 text-sm md:text-base font-light">{slide.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
      <div class="gallery-controls" data-gallery-controls hidden>
        <button type="button" data-gallery-previous aria-label="Previous photograph" aria-controls={id} disabled><span aria-hidden="true">←</span></button>
        <button type="button" data-gallery-next aria-label="Next photograph" aria-controls={id}><span aria-hidden="true">→</span></button>
      </div>
    </bba-gallery>
  </section>
)}

<style>
  bba-gallery { display: block; min-width: 0; --gallery-height: min(45vh, clamp(12rem, 28vw, 28rem)); }
  .gallery-track {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--dot-color) transparent;
    padding-bottom: 0.75rem;
  }
  .gallery-track > li {
    flex: 0 0 auto;
    width: min(calc(var(--gallery-height) * var(--gallery-ratio)), var(--gallery-native-width));
    max-width: 88%;
    scroll-snap-align: start;
  }
  .gallery-track > li:only-child { max-width: 100%; }
  .gallery-track a { display: block; cursor: pointer; }
  .gallery-track img { display: block; width: 100%; height: auto; }
  .gallery-controls { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem; }
  .gallery-controls[hidden] { display: none; }
  .gallery-controls button { min-width: 44px; min-height: 44px; font-size: 1.5rem; }
  .gallery-controls button:disabled { opacity: 0.3; cursor: default; }
  .gallery-track:focus-visible, .gallery-track a:focus-visible, .gallery-controls button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -3px;
  }
</style>

<script>
  import "../scripts/gallery";
</script>
