---
import type { ImageMetadata } from "astro";
import Logo from "./Logo.astro";
import HoldingSlideshow from "./HoldingSlideshow.astro";
import { sanity } from "../lib/sanityClient";
import { getContactPageQuery } from "../lib/queries";

type ContactData = {
  email?: string;
};

const contactData = (await sanity.fetch(getContactPageQuery)) as ContactData;
const email = contactData?.email ?? "hello@wearebba.co.uk";

const archiveUrl = "https://archived.wearebba.co.uk";

const holdingImageModules = import.meta.glob("../assets/holding/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
  import: "default",
});

const holdingSlides = Object.entries(holdingImageModules)
  .sort(([left], [right]) => left.localeCompare(right))
  .map(([path, image]) => {
    const filename = path.split("/").pop() ?? "holding image";
    const baseName = filename.replace(/\.[^.]+$/, "");
    const humanLabel = baseName
      .replace(/^[0-9_-]+/, "")
      .replace(/[-_]+/g, " ")
      .trim();

    return {
      path,
      image: image as ImageMetadata,
      alt: humanLabel
        ? `${humanLabel} by Butcher Bayley Architects`
        : "Butcher Bayley Architects project image",
    };
  });
---

<section class="relative min-h-screen overflow-hidden bg-primary text-white">
  <HoldingSlideshow slides={holdingSlides} />
  <div class="absolute inset-0 bg-black/20"></div>

  <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-[1600px] flex-col px-4 pb-8 pt-6 md:px-8 md:pb-10 md:pt-8">
    <header class="flex items-start justify-between gap-4 text-white">
      <Logo class="w-24 md:w-32" />
      <p class="pt-1 text-right text-[0.7rem] uppercase tracking-[0.22em] md:pt-2 md:text-sm">
        Butcher Bayley Architects
      </p>
    </header>

    <div class="mt-auto max-w-[28rem] pb-2 md:pb-4">
      <h1 class="text-[clamp(2.4rem,6vw,5.25rem)] leading-[0.92] tracking-[-0.04em]">
        We're building something between towns.
      </h1>
      <p class="mt-4 max-w-[22rem] text-base font-light leading-snug md:mt-5 md:text-lg">
        Our new website is on its way.
      </p>
      <div class="mt-6 space-y-2 text-base md:mt-8 md:text-lg">
        <p>
          <a
            href={archiveUrl}
            class="underline decoration-current underline-offset-4 transition-colors duration-300 hover:text-white/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            View our project archive ↗
          </a>
        </p>
        <p>
          <a
            href={`mailto:${email}`}
            class="underline decoration-white/0 underline-offset-4 transition-colors duration-300 hover:text-white/80 hover:decoration-current focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            {email}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
