---
import Logo from "./Logo.astro";

const currentYear = new Date().getFullYear();
const legalUrl = "/legal";
---

<footer class="bg-[#178FE4] text-white">
  <div
    class="flex flex-col md:flex-row justify-between items-baseline w-full max-w-[1600px] mx-auto py-8 px-4 md:p-8"
  >
    <div
      class="flex flex-col md:flex-row items-baseline md:space-x-8 md:space-y-0 space-y-4"
    >
      <a href="/" aria-label="Butcher Bayley Architects home">
        <Logo class="w-20 md:w-24" />
      </a>
      <p class="text-sm font-light">
        &copy; {currentYear} Butcher Bayley Architects
      </p>
      <a href={legalUrl} class="text-sm font-light">Legal information →</a>
      <button
        type="button"
        data-cookie-settings
        class="text-left text-sm font-light underline-offset-4 hover:underline"
      >
        Cookie settings
      </button>
    </div>
    <div class="flex space-x-4 mt-4 md:mt-0">
      <a
        href="mailto:hello@wearebba.co.uk"
        class="text-base md:text-lg font-light">hello@wearebba.co.uk</a
      >
      <a
        href="https://instagram.com/wearebba"
        target="_blank"
        rel="noopener noreferrer"
        class="text-base md:text-lg font-light">@wearebba</a
      >
    </div>
  </div>
</footer>
