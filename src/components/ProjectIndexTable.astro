---
import type { Project } from "../types/Project";
import { projectDetailHref, workIndexProjects } from "../lib/projects";
const { projects } = Astro.props as { projects: Project[] };
const indexProjects = workIndexProjects(projects);
const columns = ["Name", "Code", "County", "Context", "Typology"];
---

<section
  id="project-index"
  class="hidden p-4 md:p-8 transition-opacity duration-300 ease-in-out opacity-0 max-w-[1600px] mx-auto overflow-auto"
>
  <table class="w-full text-left">
    <caption class="sr-only">Project index, initially ordered by project number (ascending). Use the context filters above or the column buttons to sort.</caption>
    <thead>
      <tr class="text-base sm:text-lg font-bold">
        {columns.map((column, index) => (
          <th scope="col" aria-sort="none" class:list={["pb-2 pr-4", { "project-index-desktop": index === 2 || index === 3 }]}>
            <button type="button" data-sort-column={index} class="flex items-center text-left" aria-label={`Sort by ${column.toLowerCase()}`}>
              {column}<span class="chevron-icon inline-block ml-1 transition-transform duration-300"><img src="/icons/Chevron.svg" alt="" class="w-4" /></span>
            </button>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {
        indexProjects.map((project) => {
          const href = projectDetailHref(project);
          return (
          <tr data-type={project.type} class="text-sm sm:text-lg font-light align-top">
            <td class={href ? "p-0" : "py-2 pr-4"}>
              {href ? <a href={href} class="block py-2 pr-4 underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">{project.title}</a> : project.title}
            </td>
            <td class="py-2 pr-4 whitespace-nowrap">{project.postCode}</td>
            <td class="project-index-desktop py-2 pr-4">{project.county}</td>
            <td class="project-index-desktop py-2 pr-4 capitalize">{project.type}</td>
            <td class="py-2">{project.typology}</td>
          </tr>
        );})
      }
    </tbody>
  </table>
</section>

<style>
  .project-index-desktop { display: none; }
  @media (min-width: 1024px) and (orientation: landscape) {
    .project-index-desktop { display: table-cell; }
  }
</style>
