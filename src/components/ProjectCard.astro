---
import ProjectVideoPreview from "./ProjectVideoPreview.astro";
import { projectDetailHref } from "../lib/projects";
const { title, postCode, county, imageUrl, type, previewVideoUrl, project } = Astro.props;
const href = projectDetailHref(project);
const Tag = href ? "a" : "div";
const colourClass = type === "rural" ? "bg-aqua" : type === "inter-urban" ? "bg-cornflower" : type === "urban" ? "bg-pink" : "bg-primary";
---

<Tag
  href={href}
  class="group block project-card relative overflow-hidden aspect-square"
>
  {(previewVideoUrl || imageUrl) && <div class="absolute inset-0 z-0">
    {
      previewVideoUrl ? <ProjectVideoPreview videoUrl={previewVideoUrl} imageUrl={imageUrl} colourClass={colourClass} /> : imageUrl && (
        <div
          class="w-full h-full bg-center bg-cover transition-all duration-500 filter grayscale group-hover:grayscale-0 ease-in-out"
          style={`background-image: url('${imageUrl}');`}
        />
      )
    }
  </div>}

  {!previewVideoUrl && <div
    class={`absolute inset-0 z-10 ${colourClass} ${imageUrl ? "opacity-95 group-hover:opacity-0 mix-blend-multiply transition-opacity duration-500 " : ""}`}
  />}

  <div class="relative z-20 flex flex-col justify-between h-full">
    
    <div class="flex justify-between items-center p-4">
      <span class="text-4xl text-white font-light">{postCode}</span>
      {href && <img src="/icons/arrow-up-right.svg" alt="" class="arrow w-8" />}
    </div>
    <div class="flex flex-col text-white font-light p-4 overflow-hidden">
      <span class="text-sm md:text-xl">#{title}</span>
      {type && <span class="text-sm md:text-xl">#{type}</span>}
      {county && <span class="text-sm md:text-xl">#{county}</span>}
    </div>
  </div>
</Tag>
