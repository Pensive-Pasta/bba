---
import AnimatedPills from "./AnimatedPills.astro";
const { title, tabs } = Astro.props as { title: string; tabs: string[] };
---

<div class="page-grid-header site-frame relative z-30 min-h-64 md:min-h-80">
  <div class="page-grid-lead">
    <h1 class="text-2xl md:text-4xl">{title}</h1>
    <div class="page-grid-filters flex items-center text-lg">
      <AnimatedPills
        items={tabs.map((tab) => ({ value: tab.toLowerCase(), label: tab.charAt(0).toUpperCase() + tab.slice(1), controls: `${tab.toLowerCase()} ${tab.toLowerCase()}-intro` }))}
        label="Studio sections"
        buttonClass="tab"
      />
    </div>
  </div>
  <div class="page-grid-description"><slot name="introduction" /></div>
</div>
