---
import AnimatedPills from "./AnimatedPills.astro";
const { title, tabs } = Astro.props as { title: string; tabs: string[] };
---

<div class="relative z-30">
  <div class="page-header-clearance page-header-min-intro max-w-[1600px] mx-auto px-4 md:px-8">
    <h1 class="text-2xl md:text-4xl mb-12">{title}</h1>
  </div>
  <div class="flex items-center text-lg p-4 md:p-8 max-w-[1600px] mx-auto">
    <AnimatedPills
      items={tabs.map((tab) => ({ value: tab.toLowerCase(), label: tab.charAt(0).toUpperCase() + tab.slice(1), controls: tab.toLowerCase() }))}
      label="Studio sections"
      buttonClass="tab"
    />
  </div>
</div>
