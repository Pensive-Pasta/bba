---
import Logo from "./Logo.astro";
import { landingMedia } from "../lib/landingMedia";
import type { LandingContent } from "../lib/landingMedia";
const { content } = Astro.props as { content?: LandingContent | null };
const media = landingMedia(content);
const hasVideo = Boolean(media.videos.desktop || media.videos.mobile);
---

<section data-bba-landing-overlay role="dialog" aria-modal="true" aria-labelledby="landing-heading" class="visitor-landing" tabindex="-1">
  <div class="landing-media" data-landing-media data-desktop-video={media.videos.desktop || undefined} data-mobile-video={media.videos.mobile || undefined}
    style={`--landing-image-position: ${media.desktop.position}; --landing-mobile-position: ${media.mobile.position};`}>
    <picture>
      <source media="(max-width: 767.98px)" srcset={media.mobile.srcset || media.mobile.url} sizes="100vw" />
      <img src={media.desktop.url} srcset={media.desktop.srcset} sizes="100vw" alt={media.desktop.alt} decoding="async" fetchpriority="high" />
    </picture>
    {hasVideo && <video class="landing-video opacity-0" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" />}
    {hasVideo && <button type="button" data-hero-playback class="landing-playback" hidden aria-label="Play background video">Play video</button>}
  </div>
  <div class="landing-shading landing-shading--top" aria-hidden="true"></div>
  <div class="landing-shading landing-shading--bottom" aria-hidden="true"></div>
  <div class="landing-shading landing-shading--left" aria-hidden="true"></div>
  <div class="landing-shading landing-shading--right" aria-hidden="true"></div>
  <div class="landing-composition relative z-10 mx-auto flex min-h-[100dvh] w-full max-w-[1600px] flex-col px-4 pb-8 pt-6 md:px-8 md:pb-10 md:pt-8">
    <div class="flex items-stretch justify-between gap-4 text-white">
      <Logo class="w-32 md:w-40 shrink-0" />
      <div class="flex max-w-[14rem] flex-col items-end justify-between text-right md:max-w-[18rem]">
        <p class="text-bodySecondary font-medium md:text-bodyPrimary">Butcher Bayley Architects</p>
        {media.fallbackProject && <div class="relative min-h-[1.25rem] w-full md:min-h-[1.5rem]">
          <p class="absolute inset-0 whitespace-nowrap text-bodySecondary md:text-bodyPrimary">
            {media.fallbackProject.postCode && <><span class="text-bodySecondary font-medium text-white md:text-bodyPrimary">{media.fallbackProject.postCode}</span><span class="px-4 text-bodySecondary font-medium text-white md:text-bodyPrimary" aria-hidden="true">•</span></>}
            <span class="text-bodySecondary font-medium md:text-bodyPrimary">{media.fallbackProject.title}</span>
          </p>
        </div>}
      </div>
    </div>
    <div class="mt-auto max-w-[34rem] pb-2 md:max-w-[40rem] md:pb-4">
      <h2 id="landing-heading" class="whitespace-pre-line break-words text-[30px] leading-[38px] font-medium md:text-headline">{media.heading}</h2>
      {media.text && <p class="mt-4 max-w-[22rem] whitespace-pre-line break-words text-bodySecondary font-light md:mt-5 md:text-bodyPrimary">{media.text}</p>}
    </div>
    <div class="mt-8 flex flex-wrap items-end justify-between gap-4 md:mt-10">
      <p class="text-bodySecondary font-light md:text-bodyPrimary">
        <span>Oundle</span><span class="px-2 text-white" aria-hidden="true">•</span><span>Manchester</span>
      </p>
      <button type="button" class="landing-entry text-bodySecondary font-light md:text-bodyPrimary" data-landing-entry aria-label="Click to enter the Butcher Bayley Architects website" aria-describedby="landing-heading">
        <span>Click to enter</span>
        <span class="landing-progress" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</section>

<script>
  import { setupVisitorLanding } from "../scripts/visitor-landing";
  setupVisitorLanding();
  document.addEventListener("astro:page-load", setupVisitorLanding);
</script>
