---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import HoldingPageContent from "./HoldingPageContent.astro";
import HoldingLayout from "../layouts/HoldingLayout.astro";
import lakesideImage from "../assets/holding/01-lakeside.jpg";
import eastCroftExteriorDesktopImage from "../assets/holding/02-east-croft-exterior-desktop.jpg";
import eastCroftExteriorMobileImage from "../assets/holding/02-east-croft-exterior-mobile.jpg";
import copperHouseImage from "../assets/holding/03-copper-house.jpg";
import copperHouseMobileImage from "../assets/holding/03-copper-house-mobile.jpeg";
import eastCroftInteriorImage from "../assets/holding/04-east-croft-interior.jpg";
import eastCroftInteriorMobileImage from "../assets/holding/04-east-croft-interior-mobile.jpeg";

type HoldingSlide = {
  code: string;
  title: string;
  alt: string;
  image: ImageMetadata;
  mobileImage?: ImageMetadata;
  widths?: number[];
  formats?: ("avif" | "webp" | "jpg")[];
  quality?: number;
};

const holdingSlides: HoldingSlide[] = [
  {
    code: "PE2",
    title: "Lakeside",
    alt: "Visualisation of the Nene Park Trust climbing centre at Lakeside, Peterborough, showing its climbing wall and lakeside setting, by Butcher Bayley Architects",
    image: lakesideImage,
    widths: [960, 1280, 1600, 1920, 2400, 3200, 3840],
    formats: ["webp"],
    quality: 100,
  },
  {
    code: "PE27",
    title: "East Croft",
    alt: "East Croft, a playful timber addition with a standing-seam roof, set among neighbouring listed thatched cottages and tiled roofs",
    image: eastCroftExteriorDesktopImage,
    mobileImage: eastCroftExteriorMobileImage,
  },
  {
    code: "CB2",
    title: "Copper House",
    alt: "Copper House, a patinated-copper extension set within a conservation area, opening onto a landscaped setting",
    image: copperHouseImage,
    mobileImage: copperHouseMobileImage,
  },
  {
    code: "PE27",
    title: "East Croft",
    alt: "Interior of East Croft, showing a steel staircase, exposed brick and a rooflight above the hallway",
    image: eastCroftInteriorImage,
    mobileImage: eastCroftInteriorMobileImage,
  },
];

const firstSlidePreload = holdingSlides[0]
  ? await getImage({
      src: holdingSlides[0].image,
      width: 2400,
      format: "webp",
      quality: holdingSlides[0].quality,
    })
  : undefined;

const metaTitle =
  "Butcher Bayley Architects | An inter-urban architecture studio";
const metaDescription =
  "Butcher Bayley Architects is an inter-urban architecture studio. Our new website launches in September — explore our project archive in the meantime.";
---

<HoldingLayout
  title={metaTitle}
  description={metaDescription}
  preloadImageHref={firstSlidePreload?.src}
  robots="noindex,follow"
  robotsComment="Remove this robots noindex tag when the full September website launches."
  themeColor="#178fe4"
>
  <HoldingPageContent slides={holdingSlides} />
</HoldingLayout>
