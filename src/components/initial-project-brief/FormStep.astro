---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  active?: boolean;
  titleLevel?: "h1" | "h2";
  required?: boolean;
  subtitleRequired?: boolean;
}

const {
  id,
  eyebrow,
  title,
  subtitle,
  active = false,
  titleLevel = "h2",
  required = false,
  subtitleRequired = false,
} = Astro.props;
const Heading = titleLevel;
---

<section
  class="brief-step"
  data-brief-step={id}
  hidden={!active}
  aria-labelledby={`${id}-title`}
>
  {eyebrow && <p class="brief-eyebrow">{eyebrow}</p>}
  <Heading id={`${id}-title`} class="brief-step-title" tabindex="-1">
    {title}{required && <span aria-hidden="true">*</span>}
  </Heading>
  {
    subtitle && (
      <p class="brief-step-subtitle">
        {subtitle}{subtitleRequired && <span aria-hidden="true">*</span>}
      </p>
    )
  }
  <slot />
</section>
