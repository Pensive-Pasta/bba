---
import FormStep from "../FormStep.astro";
import CharacterCounter from "../CharacterCounter.astro";
import { INITIAL_PROJECT_BRIEF_CHARACTER_LIMITS as CHARACTER_LIMITS } from "../../../scripts/initial-project-brief-character-limits";
---

<FormStep
  id="project"
  eyebrow="03 · The project"
  title="What are you hoping to achieve?"
  subtitle="Tell us about the dream — why the project matters and what it's really in aid of. Aim for up to 800 characters, but don't worry about filling all of it."
  required
>
  <div class="brief-field">
    <label class="sr-only" for="project_description">What are you hoping to achieve?</label>
    <textarea
      id="project_description"
      name="project_description"
      placeholder="e.g. We want this to transform the way we live day to day — a considered, sustainable addition that feels like it's always been there…"
      maxlength={CHARACTER_LIMITS.projectDescription}
      aria-describedby="project_description-character-count"
      required
    ></textarea>
    <CharacterCounter fieldId="project_description" limit={CHARACTER_LIMITS.projectDescription} />
  </div>
</FormStep>
