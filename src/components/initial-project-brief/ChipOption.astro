---
interface Props {
  name: string;
  value: string;
  label?: string;
  type?: "checkbox" | "radio";
  stage?: string;
  description?: string;
  required?: boolean;
}

const {
  name,
  value,
  label = value,
  type = "checkbox",
  stage,
  description,
  required = false,
} = Astro.props;
const id = `${name}-${value}`.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<label class="brief-chip" for={id}>
  <input id={id} class="sr-only" type={type} name={name} value={value} required={required} />
  {stage && <span class="brief-stage-tag">{stage}</span>}
  <span class="min-w-0 flex-1">
    <span class="block">{label}</span>
    {description && <span class="mt-0.5 block text-bodyTertiary font-light">{description}</span>}
  </span>
</label>
