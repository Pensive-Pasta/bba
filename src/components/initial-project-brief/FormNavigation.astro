<div class="brief-navigation" data-brief-navigation>
  <div class="brief-navigation-inner">
    <button type="button" class="brief-button brief-button-ghost" data-brief-back hidden>
      <svg
        class="h-4 w-4"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12.5 4.5L7 10l5.5 5.5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      <span>Back</span>
    </button>
    <span class="whitespace-nowrap text-bodyTertiary font-light" data-step-index aria-live="polite"></span>
    <button type="button" class="brief-button brief-button-primary" data-brief-next>
      Let's start
    </button>
  </div>
  <p
    id="brief-navigation-error"
    class="brief-navigation-error"
    data-navigation-error
    role="alert"
    hidden
  >
    Please complete the required fields before continuing.
  </p>
</div>
