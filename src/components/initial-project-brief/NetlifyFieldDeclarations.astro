---
import {
  NETLIFY_FIELD_NAMES,
  NETLIFY_PDF_FIELD_NAME,
} from "../../scripts/initial-project-brief-netlify";

// Programmatic submission fields must also exist in the built HTML for Netlify's form scanner.
// The visible contact step already renders a real input with name="email".
const separatelyDeclaredFields = new Set(["email"]);
---

<div hidden aria-hidden="true" data-netlify-field-declarations>
  {
    NETLIFY_FIELD_NAMES.filter((field) => !separatelyDeclaredFields.has(field)).map(
      (field) => <input type="hidden" name={field} value="" />,
    )
  }
  <input type="file" name={NETLIFY_PDF_FIELD_NAME} tabindex="-1" />
</div>
