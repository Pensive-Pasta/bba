---
import type { Insight } from "../types/Insight";
import InsightCard from "./InsightCard.astro";
const { insights } = Astro.props as { insights: Insight[] };
---

<div
  class="image-grid site-frame site-frame--fluid grid grid-cols-2 lg:grid-cols-4"
>
  {
    insights.map((insight) => (
     <div class="card image-grid-cell" data-type={insight.type.toLowerCase()}>
        <InsightCard {...insight} />
      </div>
    ))
  }
</div>
