---
import type { GallerySlide } from "../lib/gallery";

interface Props {
  slide: GallerySlide;
  fullWidth?: boolean;
}

const { slide, fullWidth = false } = Astro.props;
---

<figure class="min-w-0 px-4 md:px-8">
  <a href={slide.lightbox} data-gallery-image data-astro-reload
    data-pswp-width={slide.lightboxWidth} data-pswp-height={slide.lightboxHeight}
    data-pswp-srcset={slide.lightboxSrcset}
    aria-label={`Enlarge photograph: ${slide.alt}`}
    class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
    <img src={slide.thumbnail} srcset={slide.srcset}
      sizes={fullWidth ? "100vw" : "(min-width: 768px) 50vw, 100vw"}
      width={slide.width} height={slide.height} alt={slide.alt}
      class="block w-full h-auto" loading="lazy" decoding="async" />
  </a>
  {slide.caption && <figcaption class="mt-2 text-sm md:text-base font-light">{slide.caption}</figcaption>}
</figure>
