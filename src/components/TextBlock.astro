---
import type { PortableTextBlock } from "@portabletext/types";
import { toHTML } from "@portabletext/to-html";

interface Props {
  content: PortableTextBlock[];
  alignment: "left" | "right";
  embedded?: boolean;
}

const { content, alignment, embedded = false } = Astro.props;
const alignmentClass =
  alignment === "right" ? "md:ml-auto md:mr-0" : "md:mr-auto md:ml-0";

const html = toHTML(content, {
  components: {
    block: {
      h2: ({ children }) =>
        `<h2 class="text-xl md:text-2xl text-primary font-bold mt-8 mb-4 first:mt-0">${children}</h2>`,
      normal: ({ children }) =>
        `<p class="text-lg md:text-xl text-primary font-light break-words hyphens-none mb-4 last:mb-0">${children}</p>`,
    },
    marks: {
      strong: ({ children }) =>
        `<strong class="font-bold">${children}</strong>`,
    },
  },
});
---

<section
  class={embedded ? "w-full break-words" : `w-full md:w-1/2 px-4 md:pr-8 mb-12 break-words ${alignmentClass}`}
>
  <div set:html={html} />
</section>
