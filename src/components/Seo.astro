---
import { pageRobots } from "../lib/deployment";
import { firstNonEmpty, safeJsonLd } from "../lib/seo";
interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  siteOrigin: string;
  robots?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const defaultOgImage = "/images/logo-og.jpg";
const allowIndexing = import.meta.env.BBA_INDEXING_ENABLED === true;

const {
  title: requestedTitle,
  description: requestedDescription,
  ogType = "website",
  ogImage: passedOgImage,
  ogImageAlt = "",
  canonical,
  siteOrigin,
  robots: requestedRobots,
  jsonLd,
} = Astro.props;
const title = firstNonEmpty(requestedTitle) || "Butcher Bayley Architects (BBA) | RIBA Chartered Practice";
const description = firstNonEmpty(requestedDescription) || "RIBA chartered practice designing sustainable architecture.";

const toAbsoluteUrl = (value: string) => {
  if (/^https?:\/\//i.test(value)) return value;
  return new URL(value, siteOrigin).toString();
};

const ogImage = toAbsoluteUrl(passedOgImage ?? defaultOgImage);
const robots = pageRobots(allowIndexing, requestedRobots);

const siteName = "Butcher Bayley Architects";
const locale = "en_GB";
const jsonLdEntries = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((entry) =>
      safeJsonLd(entry),
    )
  : [];
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<meta name="robots" content={robots} />

<link rel="icon" href="/favicon.svg?v=white" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/images/BBA-Logo.png" />
<meta name="theme-color" content="#ffffff" />

{
  jsonLdEntries.map((entry) => (
    <Fragment
      set:html={`<script type="application/ld+json">${entry}</script>`}
    />
  ))
}
