---
interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  canonical?: string;
  siteOrigin: string;
  robots?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const defaultOgImage = "/images/logo-og.jpg";
const allowIndexing =
  import.meta.env.PUBLIC_ALLOW_INDEXING?.trim().toLowerCase() === "true";
const defaultRobots = allowIndexing
  ? "index,follow,max-image-preview:large"
  : "noindex,follow";

const {
  title = "Butcher Bayley Architects (BBA) | RIBA Chartered Practice",
  description = "RIBA chartered practice designing sustainable architecture.",
  ogType = "website",
  ogImage: passedOgImage,
  canonical,
  siteOrigin,
  robots = defaultRobots,
  jsonLd,
} = Astro.props;

const toAbsoluteUrl = (value: string) => {
  if (/^https?:\/\//i.test(value)) return value;
  return new URL(value, siteOrigin).toString();
};

const ogImage = toAbsoluteUrl(passedOgImage ?? defaultOgImage);

const siteName = "Butcher Bayley Architects";
const locale = "en_GB";
const jsonLdEntries = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((entry) =>
      JSON.stringify(entry),
    )
  : [];
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`${title} – ${siteName}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${title} – ${siteName}`} />

<meta name="robots" content={robots} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/images/BBA-Logo.png" />
<meta name="theme-color" content="#ffffff" />

{
  jsonLdEntries.map((entry) => (
    <Fragment
      set:html={`<script type="application/ld+json">${entry}</script>`}
    />
  ))
}
