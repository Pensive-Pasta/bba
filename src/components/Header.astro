---
import Logo from "./Logo.astro";

const navItems = [
  { name: "Work", url: "/work", color: "text-orange" },
  { name: "Studio", url: "/studio", color: "text-green" },
  { name: "Insights", url: "/insights", color: "text-yellow" },
  { name: "Contact", url: "/contact", color: "text-pink" },
];

const currentYear = new Date().getFullYear();
const { hideMenu = false } = Astro.props;

const textColor = "text-white";
const legalUrl = "/legal";
---

<header
  id="site-header"
  class={`min-w-full sticky top-0 left-0 right-0 z-40 shrink-0 bg-primary duration-500 ease-out transition-transform ${textColor}`}
>
  <div
    class="site-header-bar flex justify-between items-center max-w-[1600px] mx-auto px-4 md:px-8"
  >
    <a
      href="/"
      class="text-xl font-light tracking-tighter z-40 header-link text-current"
      aria-label="Butcher Bayley Architects home"
    >
      <span class="header-text">
        <Logo class="logo" />
      </span>
    </a>

    {
      !hideMenu && (
        <button
          class="group z-40 relative"
          id="menu-toggle"
          type="button"
          aria-label="Toggle menu"
          aria-controls="nav-menu"
          aria-expanded="false"
        >
          <div class="w-12 h-10 flex flex-col justify-between overflow-hidden">
            <span class="w-full h-1 transform transition-all duration-300 origin-left menu-line-1 bg-current group-aria-[expanded=false]:translate-y-1" />
            <span class="w-full h-1 transition-all duration-300 origin-center menu-line-2 bg-current" />
            <span class="w-full h-1 transform transition-all duration-300 origin-left menu-line-3 bg-current group-aria-[expanded=false]:-translate-y-1" />
          </div>
        </button>
      )
    }
  </div>

  {
    !hideMenu && (
      <div
        class="nav-menu fixed inset-0 min-h-screen w-screen z-30 hidden overflow-auto isolate bg-[#178FE4]"
        id="nav-menu"
        aria-hidden="true"
      >
    <div
      id="nav-bg"
      class="absolute inset-0 z-0 pointer-events-none overflow-hidden bg-[#178FE4]"
    >
    </div>
    <div class="relative z-10 h-full max-w-[1600px] mx-auto">
      <div
        class="flex flex-col items-center justify-between h-full bg-primary pt-[160px] px-4 md:px-8 pb-8"
      >
        <nav class="dot-grid w-full max-w-[600px] aspect-square" aria-label="Primary">
          {
            navItems.map((item) => (
              <a
                href={item.url}
                class="group aspect-square flex items-start justify-start text-white p-4 text-2xl lg:text-4xl text-center"
              >
                <p class="relative group transition-transform duration-500 mt-1">
                  {item.name}
                  <span class="hidden lg:block absolute left-0 -bottom-1 w-0 h-[2px] bg-current transition-all duration-300 group-hover:w-full" />
                </p>
              </a>
            ))
          }
        </nav>
        <div class="mb-1 w-full">
          <ul
            class="flex justify-between items-center text-white text-sm lg:text-lg transition-colors font-light"
          >
            <li>
              <p>
                &copy; {currentYear} Butcher Bayley Architects
              </p>
            </li>
            <li>
              <a class="flex items-center gap-2" href={legalUrl}>
                Legal information
                <span class="inline-block text-white mt-1">
                  <img
                    src="/icons/Policy-Arrow.svg"
                    alt=""
                    aria-hidden="true"
                    class="w-4"
                  />
                </span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
      </div>
    )
  }
</header>

<script>
  const setupMobileMenu = () => {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("nav-menu");
    const body = document.body;
    const menuLine1 = document.querySelector(".menu-line-1");
    const menuLine2 = document.querySelector(".menu-line-2");
    const menuLine3 = document.querySelector(".menu-line-3");
    const logo = document.querySelector(".logo");
    const navWindow = window as Window & {
      __bbaNavController?: AbortController;
    };

    if (!menuToggle || !mobileMenu) return;
    navWindow.__bbaNavController?.abort();

    const controller = new AbortController();
    const { signal } = controller;
    navWindow.__bbaNavController = controller;

    const setMenuState = (isOpen: boolean) => {
      const changed = menuToggle.getAttribute("aria-expanded") !== String(isOpen);
      mobileMenu.classList.toggle("hidden", !isOpen);
      mobileMenu.setAttribute("aria-hidden", String(!isOpen));
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      body.classList.toggle("overflow-hidden", isOpen);
      logo?.classList.add("text-white");
      logo?.classList.remove("text-primary");

      menuLine1?.classList.toggle("rotate-45", isOpen);
      menuLine1?.classList.toggle("translate-x-1", isOpen);
      menuLine1?.classList.toggle("translate-y-[1px]", isOpen);
      menuLine2?.classList.toggle("scale-x-0", isOpen);
      menuLine3?.classList.toggle("-rotate-45", isOpen);
      menuLine3?.classList.toggle("translate-x-1", isOpen);
      menuLine1?.classList.toggle("!bg-white", isOpen);
      menuLine2?.classList.toggle("!bg-white", isOpen);
      menuLine3?.classList.toggle("!bg-white", isOpen);
      if (changed) document.getElementById("site-header")?.dispatchEvent(
        new CustomEvent("bba:menu-state", { detail: { open: isOpen } })
      );
    };

    const closeMenu = () => setMenuState(false);

    menuToggle.addEventListener(
      "click",
      (event) => {
        event.preventDefault();
        setMenuState(mobileMenu.classList.contains("hidden"));
      },
      { signal }
    );

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu, { signal });
    });

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") closeMenu();
      },
      { signal }
    );

    document.addEventListener(
      "astro:before-swap",
      () => {
        closeMenu();
        controller.abort();
      },
      { once: true, signal }
    );

    closeMenu();
  };

  if (document.readyState !== "loading") {
    setupMobileMenu();
  } else {
    document.addEventListener("DOMContentLoaded", setupMobileMenu);
  }

  // Re-run on client-side navigation
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>

<script is:inline>
  const initNavHover = () => {
    const bgEl = document.getElementById("nav-bg");

    if (!bgEl) return;

    const applyTheme = () => {
      bgEl.className =
        "fixed inset-0 -z-10 pointer-events-none overflow-hidden bg-[#178FE4]";
    };

    applyTheme(); // correct background on load
  };

  if (document.readyState !== "loading") {
    initNavHover();
  } else {
    document.addEventListener("DOMContentLoaded", initNavHover);
  }
  document.addEventListener("astro:page-load", initNavHover);
</script>

<script>
  import { initHeaderScroll } from "../scripts/header-scroll";

  let cleanup: (() => void) | undefined;
  const setupHeaderScroll = () => {
    cleanup?.();
    const header = document.getElementById("site-header");
    cleanup = header ? initHeaderScroll(header) : undefined;
  };
  setupHeaderScroll();
  document.addEventListener("astro:page-load", setupHeaderScroll);
  window.addEventListener("pageshow", setupHeaderScroll);
</script>
