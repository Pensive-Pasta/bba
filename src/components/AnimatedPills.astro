---
interface Item { value: string; label: string; controls?: string; }
interface Props {
  items: Item[];
  label: string;
  buttonClass: string;
  valueAttribute?: "data-type" | "data-tab";
  indicatorId?: string;
}
const { items, label, buttonClass, valueAttribute = "data-tab", indicatorId } = Astro.props;
---

<div
  data-animated-pills
  role="group"
  aria-label={label}
  class="filter-toggle-group w-full max-w-[660px] relative flex flex-nowrap whitespace-nowrap items-center justify-between md:justify-end sm:gap-2 border-2 border-primary rounded-full below-xs:text-xs text-sm md:text-xl"
>
  {items.map((item, index) => (
    <button
      type="button"
      data-pill-button
      {...{ [valueAttribute]: item.value }}
      aria-pressed={index === 0 ? "true" : "false"}
      aria-controls={item.controls}
      class:list={[
        buttonClass,
        index === 0
          ? "rounded-full px-2 sm:px-5 lg:px-8 py-2 active-filter min-w-[50px] sm:min-w-[68px] w-full"
          : "rounded-full px-3 sm:px-5 lg:px-8 py-2 w-full",
      ]}
    >{item.label}</button>
  ))}
  <span
    id={indicatorId}
    data-pill-indicator
    aria-hidden="true"
    class="absolute top-0 left-0 h-full rounded-full bg-primary transition-transform duration-300 ease-out pointer-events-none z-[-1]"
  ></span>
</div>

<style>
  .active-filter { color: white; }
</style>
<script is:inline type="module" src="/scripts/animatedPills.js"></script>
