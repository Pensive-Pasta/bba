---
import type { PageContent } from "../types/PageContent";
import { normaliseText } from "../utils/normaliseText";

const { title, description } = Astro.props as PageContent;

const introRaw = description;
const intro = normaliseText(introRaw);
---

<section
  class="page-grid-header site-frame"
>
  <div class="page-grid-lead">
    <h1 class="text-2xl md:text-4xl">{title}</h1>
    <slot />
  </div>
  <div class="page-grid-description">
    {
      intro.map((para: string) => (
        <p class="text-lg md:text-xl leading-normal text-primary mb-4 font-light">
          {para.replace(/\n+/g, " ")}
        </p>
      ))
    }
  </div>
</section>
