---
import type { Person } from "../types/StudioPage";
import { normaliseText } from "../utils/normaliseText";
const { people } = Astro.props as { people: Person[] };

function getFirstName(fullName: string | undefined): string {
  return fullName ? fullName.split(" ")[0] : "";
}

const normalisedPeople = people.map((person) => ({
  ...person,
  bio: normaliseText(person.bio),
}));
---

<div
  class="image-grid grid w-full min-w-0 grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-y-16 text-primary pt-0"
>
  {
    normalisedPeople.map((person) => (
      <div class="image-grid-cell flex min-w-0 flex-col items-start">
        {person.image?.url && (
          <div class="image-grid-media relative aspect-square w-[calc(100%-2rem)] mx-4 md:w-full md:mx-0 shrink-0 overflow-hidden">
            <img
              src={person.image.url}
              alt={person.image.alt || person.name || ""}
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>
        )}
        <div class="w-full min-w-0 break-words p-4">
          {person.name && (
            <h2 class="text-lg md:text-xl font-bold mb-1">{person.name}</h2>
          )}
          {person.position && (
            <p class="text-lg md:text-xl font-bold mb-6">{person.position}</p>
          )}
          {person.bio.map((para) => (
            <p class="text-base md:text-lg font-light leading-relaxed mb-4">
              {para.replace(/\n+/g, " ")}
            </p>
          ))}
          <div class="flex flex-col gap-1 text-sm md:text-base italic">
            {person.socialLink && (
              <a
                href={person.socialLink}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-accent transition"
              >
                Follow {getFirstName(person.name)}
              </a>
            )}
            {person.email && (
              <a
                href={`mailto:${person.email}`}
                class="hover:text-accent transition"
              >
                Email {getFirstName(person.name)}
              </a>
            )}
          </div>
        </div>
      </div>
    ))
  }
</div>
