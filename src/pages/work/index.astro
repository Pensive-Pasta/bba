---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanity } from "../../lib/sanityClient";
import { getWorkPageQuery } from "../../lib/queries";
import { workGridProjects } from "../../lib/projects";
import ProjectFilterControls from "../../components/ProjectFilterControls.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import ProjectIndexTable from "../../components/ProjectIndexTable.astro";
import WorkHeader from "../../components/WorkHeader.astro";
import {
  resolveSeoTitle,
  resolveSeoDescription,
  resolveSeoImage,
  SITE_TITLE_SUFFIX,
} from "../../lib/seo";

const workPage = await sanity.fetch(getWorkPageQuery);
const projects = workGridProjects(workPage?.projects);

const metaTitle = resolveSeoTitle(workPage?.seo?.metaTitle, `${workPage?.title || "Work"} | ${SITE_TITLE_SUFFIX}`);
const metaDescription = resolveSeoDescription(
  workPage?.seo?.metaDescription,
  workPage?.description,
  "Explore Butcher Bayley Architects’ portfolio. Filter projects by urban, inter-urban and rural settings, showcasing our sustainable, place-making approach."
);
const ogImage = resolveSeoImage(workPage?.seo?.ogImage);
---

<BaseLayout
  mainClass="page-grid-main"
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImage}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Work", path: "/work/" },
  ]}
>
  <section id="work-page" class="">
    <WorkHeader title={workPage.title} description={workPage.description}>
      <ProjectFilterControls />
    </WorkHeader>
    <div class="work-results">
      <ProjectGrid projects={projects} />
      <ProjectIndexTable projects={workPage?.indexProjects ?? []} />
    </div>
  </section>

  <style>
    :global(.active-filter) {
      @apply text-white;
    }
  </style>

  <script is:inline src="/scripts/projectToggle.js" type="module"></script>
</BaseLayout>
