---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import { sanity } from "../../lib/sanityClient";
import { getCaseStudiesQuery, getProjectBySlugQuery } from "../../lib/queries";
import { projectDetailHref } from "../../lib/projects";
import type { Project } from "../../types/Project";
import ContentBlock from "../../components/ContentBlock.astro";
import ProjectIntroduction from "../../components/ProjectIntroduction.astro";
import Credits from "../../components/Credits.astro";
import { projectIntroduction } from "../../lib/projectIntroduction";
import "../../styles/project-detail.css";
import {
  portableTextToPlainText,
  resolveSeoTitle,
  resolveSeoDescription,
  resolveSeoImage,
  SITE_TITLE_SUFFIX,
} from "../../lib/seo";

const { slug } = Astro.params;

export async function getStaticPaths() {
  const projects: Project[] = await sanity.fetch(getCaseStudiesQuery);
  return projects.filter((project) => projectDetailHref(project)).map((project) => ({ params: { slug: project.slug!.current } }));
}

const projectInfo = await sanity.fetch(getProjectBySlugQuery, { slug });
if (!projectInfo || !projectDetailHref(projectInfo)) {
  throw new Error(`Case study became unavailable during build: ${slug}`);
}
const { introduction, body, startIndex } = projectIntroduction(projectInfo.contentBlocks);
const hasHero = Boolean(projectInfo.imageUrl || projectInfo.heroVideo?.url ||
  projectInfo.mobileHeroImage?.asset?.url || projectInfo.mobileHeroVideo?.url);

const seoTitle = resolveSeoTitle(projectInfo.seo?.metaTitle, `${projectInfo.title} | Work | ${SITE_TITLE_SUFFIX}`);
const completion = projectInfo.credits?.find((credit: { label: string; value: string }) => credit.label === "Completion")?.value;
const projectSummary = [
  projectInfo.type
    ? `${projectInfo.type.charAt(0).toUpperCase() + projectInfo.type.slice(1)} project`
    : undefined,
  projectInfo.county ? `in ${projectInfo.county}` : undefined,
  completion ? `Completion: ${completion}` : projectInfo.year ? `Year: ${projectInfo.year}` : undefined,
]
  .filter(Boolean)
  .join(", ");
const blockText = portableTextToPlainText(projectInfo.contentBlocks);
const seoDescription = resolveSeoDescription(
  projectInfo.seo?.metaDescription,
  blockText,
  projectSummary ? `${projectInfo.title}, ${projectSummary}.` : projectInfo.title
);
const ogImage = resolveSeoImage(
  projectInfo.seo?.ogImage,
  projectInfo.heroImage
);
---

<BaseLayout
  mainClass="page-grid-main page-grid-main--md"
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogImageAlt={projectInfo.seo?.ogImage?.asset?.url ? projectInfo.seo.ogImage.altText : projectInfo.altText}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Work", path: "/work/" },
    { name: projectInfo.title, path: `/work/${slug}/` },
  ]}
>
  <article class="project-detail">
    <h1 id="project-title" class="sr-only">{projectInfo.title}</h1>
    {
      hasHero && (
        <Hero
          image={projectInfo.imageUrl}
          alt={projectInfo.altText}
          heroImage={projectInfo.heroImage}
          heroVideo={projectInfo.heroVideo}
          mobileHeroImage={projectInfo.mobileHeroImage}
          mobileHeroVideo={projectInfo.mobileHeroVideo}
        />
      )
    }

    <ProjectIntroduction projectInfo={projectInfo} introduction={introduction} />

    {
      body.length > 0 && (
        <section class="project-editorial content-separators">
          <ContentBlock blocks={body} startIndex={startIndex} />
        </section>
      )
    }
    <Credits credits={projectInfo.credits ?? []} />
  </article>
</BaseLayout>
