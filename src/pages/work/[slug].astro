---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageDotGrid from "../../components/PageDotGrid.astro";
import Hero from "../../components/Hero.astro";
import { sanity } from "../../lib/sanityClient";
import { getProjectBySlugQuery } from "../../lib/queries";
import ContentBlock from "../../components/ContentBlock.astro";
import ProjectMeta from "../../components/ProjectMeta.astro";
import Credits from "../../components/Credits.astro";
import {
  portableTextToPlainText,
  resolveSeoDescription,
  resolveSeoImage,
  SITE_TITLE_SUFFIX,
} from "../../lib/seo";

const { slug } = Astro.params;

export async function getStaticPaths() {
  const projects = await sanity.fetch(
    `*[_type == "project"]{ "slug": slug.current }`
  );
  return projects.map((p: { slug: string }) => ({ params: { slug: p.slug } }));
}

const projectInfo = await sanity.fetch(getProjectBySlugQuery, { slug });
const hasHero = Boolean(projectInfo.imageUrl || projectInfo.heroVideo?.url ||
  projectInfo.mobileHeroImage?.asset?.url || projectInfo.mobileHeroVideo?.url);

const seoTitle =
  projectInfo.seo?.metaTitle ?? `${projectInfo.title} | Work | ${SITE_TITLE_SUFFIX}`;
const completion = projectInfo.credits?.find((credit: { label: string; value: string }) => credit.label === "Completion")?.value;
const projectSummary = [
  projectInfo.type
    ? `${projectInfo.type.charAt(0).toUpperCase() + projectInfo.type.slice(1)} project`
    : undefined,
  projectInfo.county ? `in ${projectInfo.county}` : undefined,
  completion ? `Completion: ${completion}` : projectInfo.year ? `Year: ${projectInfo.year}` : undefined,
]
  .filter(Boolean)
  .join(", ");
const blockText = portableTextToPlainText(projectInfo.contentBlocks);
const seoDescription = resolveSeoDescription(
  projectInfo.seo?.metaDescription,
  blockText,
  projectSummary ? `${projectInfo.title}, ${projectSummary}.` : projectInfo.title
);
const heroOgImage = projectInfo.imageUrl
  ? `${projectInfo.imageUrl}?w=1200&h=630&fit=crop&auto=format&q=80`
  : undefined;
const ogImage = resolveSeoImage(
  projectInfo.seo?.ogImage?.asset?.url,
  heroOgImage
);
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Work", path: "/work/" },
    { name: projectInfo.title, path: `/work/${slug}/` },
  ]}
>
  <PageDotGrid />
  <article class="page-header-min-screen">
    <h1 class="sr-only">{projectInfo.title}</h1>
    {
      hasHero && (
        <Hero
          image={projectInfo.imageUrl}
          alt={projectInfo.altText}
          heroImage={projectInfo.heroImage}
          heroVideo={projectInfo.heroVideo}
          mobileHeroImage={projectInfo.mobileHeroImage}
          mobileHeroVideo={projectInfo.mobileHeroVideo}
          scrollTarget="projects"
        />
      )
    }

    <section
      class={`${hasHero ? "mt-12" : ""} ${!hasHero ? "page-header-margin-clearance page-header-clearance--project" : ""} ${projectInfo.contentBlocks.length === 0 ? "mb-12" : ""} px-4 md:px-8`}
    >
      <ProjectMeta projectInfo={projectInfo} />
    </section>

    {
      projectInfo.contentBlocks.length >= 1 && (
        <section class={`mt-12 ${hasHero ? "md:-mt-32" : ""} mb-32`}>
          <ContentBlock blocks={projectInfo.contentBlocks} />
        </section>
      )
    }

    {
      projectInfo.credits?.length > 0 && (
        <Credits credits={projectInfo.credits} />
      )
    }
  </article>
</BaseLayout>
