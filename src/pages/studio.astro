---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentBlock from "../components/ContentBlock.astro";
import { sanity } from "../lib/sanityClient";
import { getStudioPageQuery } from "../lib/queries";
import PeopleGrid from "../components/PeopleGrid.astro";
import StudioHeader from "../components/StudioHeader.astro";
import TextBlock from "../components/TextBlock.astro";
import { studioIntroduction } from "../lib/studioIntroduction";
import {
  portableTextToPlainText,
  resolveSeoDescription,
  resolveSeoImage,
  SITE_TITLE_SUFFIX,
} from "../lib/seo";

const studioPage = await sanity.fetch(getStudioPageQuery);
const sections = [
  { key: "profile", heading: "Profile", ...studioIntroduction(studioPage.profileBlocks, "Profile") },
  { key: "people", heading: "People", ...studioIntroduction([{ _type: "textBlock", content: studioPage.peopleIntro }], "People") },
  { key: "values", heading: "Values", ...studioIntroduction(studioPage.valuesBlocks, "Values") },
  { key: "awards", heading: "Awards", ...studioIntroduction(studioPage.awardsBlocks, "Awards") },
];

const metaTitle =
  studioPage?.seo?.metaTitle || `${studioPage?.title ?? "Studio"} | ${SITE_TITLE_SUFFIX}`;
const metaDescription = resolveSeoDescription(
  studioPage?.seo?.metaDescription,
  portableTextToPlainText(studioPage?.profileBlocks),
  "Meet our team, discover our values, and explore the profile of Butcher Bayley Architects, a RIBA Chartered Practice."
);
const ogImage = resolveSeoImage(studioPage?.seo?.ogImage?.asset?.url);
---

<BaseLayout
  mainClass="page-grid-main"
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImage}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Studio", path: "/studio/" },
  ]}
>
  <StudioHeader
    title="Studio"
    tabs={sections.map(({ key }) => key)}
  >
    <div slot="introduction">
      {sections.map(({ key, heading, introduction, hasHeading }, index) => (
        <div id={`${key}-intro`} class:list={{ hidden: index !== 0 }}>
          {!hasHeading && <h2 class="text-xl md:text-2xl text-primary font-bold mb-4">{heading}</h2>}
          <div class="space-y-4">
            {introduction.map((block) => <TextBlock content={block.content!} alignment="right" embedded />)}
          </div>
        </div>
      ))}
    </div>
  </StudioHeader>

  <section id="studio-page" class="site-frame">
    {sections.map(({ key, body, startIndex }, index) => (
      <div id={key} class:list={["w-full min-w-0 content-separators", { hidden: index !== 0 }]}>
        {key === "people" ? <PeopleGrid people={studioPage.people} /> : <ContentBlock blocks={body} startIndex={startIndex} />}
      </div>
    ))}
  </section>

  <script is:inline type="module" src="/scripts/studioTabs.js"></script>
</BaseLayout>
