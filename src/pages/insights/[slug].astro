---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentBlock from "../../components/ContentBlock.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { sanity } from "../../lib/sanityClient";
import { getInsightBySlugQuery, getInsightsQuery } from "../../lib/queries";
import { isPublicInsight } from "../../lib/publicContent";
import { canonicalUrl } from "../../lib/deployment";
import type { Insight } from "../../types/Insight";
import {
  findFirstImageUrl,
  portableTextToPlainText,
  resolveSeoTitle,
  resolveSeoDescription,
  resolveSeoImage,
  SITE_NAME,
  SITE_TITLE_SUFFIX,
} from "../../lib/seo";

const { slug } = Astro.params;

export async function getStaticPaths() {
  const insights: Insight[] = await sanity.fetch(getInsightsQuery);
  return insights.filter((insight) => isPublicInsight(insight)).map((insight) => ({ params: { slug: insight.slug.current } }));
}

const insight = await sanity.fetch(getInsightBySlugQuery, { slug });
if (!isPublicInsight(insight)) throw new Error(`Published Insight is unavailable or has an invalid slug: ${slug}`);

const seoTitle = resolveSeoTitle(insight.seo?.metaTitle, `${insight.title} | Insights | ${SITE_TITLE_SUFFIX}`);
const seoDescription = resolveSeoDescription(
  insight.seo?.metaDescription,
  portableTextToPlainText(insight.contentBlocks),
  `Read ${insight.title} from ${SITE_NAME}.`
);
const seoOgImage = resolveSeoImage(
  insight.seo?.ogImage,
  findFirstImageUrl(insight.contentBlocks)
);
const publishedIso = new Date(insight.publishedAt).toISOString();
const modifiedIso = new Date(insight._updatedAt || insight.publishedAt).toISOString();
const articleUrl = canonicalUrl(`/insights/${slug}/`, Astro.site!.toString());
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${articleUrl}#article`,
  mainEntityOfPage: articleUrl,
  headline: insight.title,
  description: seoDescription,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  image: [new URL(seoOgImage, Astro.site).toString()],
  author: {
    "@type": "Organization",
    "@id": `${Astro.site!.origin}/#organization`,
    name: SITE_NAME,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${Astro.site!.origin}/#organization`,
    name: SITE_NAME,
  },
};
---

<BaseLayout
  mainClass="page-grid-main page-grid-main--md"
  title={seoTitle}
  description={seoDescription}
  ogType="article"
  ogImage={seoOgImage}
  ogImageAlt={insight.seo?.ogImage?.asset?.url ? insight.seo.ogImage.altText : insight.contentBlocks?.flatMap((block: any) => block.images || []).find((image: any) => image.asset?.url)?.altText}
  jsonLd={articleJsonLd}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Insights", path: "/insights/" },
    { name: insight.title, path: `/insights/${slug}/` },
  ]}
>
  <article class="site-frame pb-20 page-header-clearance">
    <div class="mb-4 px-4 md:px-8 md:w-1/2">
      <Breadcrumbs parentLabel="Insights" parentHref="/insights/" title={insight.title} />
    </div>
    <h1 class="text-3xl md:text-4xl font-bold mb-4 px-4 md:px-8 md:w-1/2">
      {insight.title}
    </h1>
    <p class="text-sm mb-12 px-4 md:px-8">
      <time datetime={publishedIso}>{new Date(insight.publishedAt).toLocaleDateString("en-GB", {timeZone: "Europe/London"})}</time>
    </p>
    <div class="content-separators mt-12 md:-mt-32">
      <ContentBlock blocks={insight.contentBlocks} />
    </div>
  </article>
</BaseLayout>
