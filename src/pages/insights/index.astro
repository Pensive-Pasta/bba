---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InsightGrid from "../../components/InsightGrid.astro";
import PageDotGrid from "../../components/PageDotGrid.astro";
import { sanity } from "../../lib/sanityClient";
import { getInsightsQuery, getInsightPageQuery } from "../../lib/queries";
import {
  resolveSeoDescription,
  resolveSeoImage,
  SITE_TITLE_SUFFIX,
} from "../../lib/seo";

const insightPage = await sanity.fetch(getInsightPageQuery);
const insights = await sanity.fetch(getInsightsQuery);
const filterTypes = ["all", "news", "projects", "thinking"];

const metaTitle =
  insightPage?.seo?.metaTitle || `${insightPage?.title ?? "Insights"} | ${SITE_TITLE_SUFFIX}`;
const metaDescription = resolveSeoDescription(
  insightPage?.seo?.metaDescription,
  "Latest news, projects, and thinking from Butcher Bayley Architects."
);
const ogImage = resolveSeoImage(insightPage?.seo?.ogImage?.asset?.url);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImage}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Insights", path: "/insights/" },
  ]}
>
  <section id="insights-page" class="">
    <PageDotGrid />

    <div class="pt-[200px] min-h-[100vh] max-w-[1600px] mx-auto">
      <h1 class="text-2xl md:text-4xl mb-4 px-4 md:px-8">
        {insightPage?.title || "Insights"}
      </h1>

      <div class="flex gap-2 md:gap-4 text-lg mb-8 px-4 md:px-8">
        {
          filterTypes.map((type, i) => (
            <button
              class={`insight-tab text-primary cursor-pointer ${i === 0 ? "opacity-50 italic" : "opacity-100"}`}
              data-tab={type}
            >
              {type.charAt(0).toUpperCase() + type.slice(1)}
            </button>
          ))
        }
      </div>

      <div id="insight-all">
        <InsightGrid insights={insights} />
      </div>

      {
        filterTypes.slice(1).map((type) => (
          <div id={`insight-${type}`} class="hidden">
            <InsightGrid
              insights={insights.filter(
                (i: { type: string }) => i.type === type
              )}
            />
          </div>
        ))
      }
    </div>
  </section>

  <script is:inline type="module" src="/scripts/insightTabs.js"></script>
</BaseLayout>
