---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedPills from "../../components/AnimatedPills.astro";
import InsightGrid from "../../components/InsightGrid.astro";
import { sanity } from "../../lib/sanityClient";
import { getInsightsQuery, getInsightPageQuery } from "../../lib/queries";
import { isPublicInsight } from "../../lib/publicContent";
import type { Insight } from "../../types/Insight";
import { normaliseText } from "../../utils/normaliseText";
import {
  resolveSeoTitle,
  resolveSeoDescription,
  resolveSeoImage,
  SITE_TITLE_SUFFIX,
} from "../../lib/seo";

const insightPage = await sanity.fetch(getInsightPageQuery);
const introduction = normaliseText(insightPage?.description);
const insights = (await sanity.fetch(getInsightsQuery)).filter((insight: Insight) => isPublicInsight(insight));
const filterTypes = ["all", "news", "projects", "thinking"];

const metaTitle = resolveSeoTitle(insightPage?.seo?.metaTitle, `${insightPage?.title || "Insights"} | ${SITE_TITLE_SUFFIX}`);
const configuredDescription = insightPage?.seo?.metaDescription?.trim();
const metaDescription = resolveSeoDescription(
  configuredDescription,
  insightPage?.description,
  "Latest news, projects, and perspectives from Butcher Bayley Architects."
);
const ogImage = resolveSeoImage(insightPage?.seo?.ogImage);
---

<BaseLayout
  mainClass="page-grid-main"
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImage}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Insights", path: "/insights/" },
  ]}
>
  <section id="insights-page" class="">
    <div class="page-header-min-screen">
      <div class="page-grid-header site-frame">
        <div class="page-grid-lead">
          <h1 class="text-2xl md:text-4xl">
            {insightPage?.title || "Insights"}
          </h1>
          <div class="page-grid-filters flex items-center text-lg">
            <AnimatedPills
              items={filterTypes.map((type) => ({ value: type, label: type === "thinking" ? "Perspectives" : type.charAt(0).toUpperCase() + type.slice(1), controls: `insight-${type}` }))}
              label="Filter insights"
              buttonClass="insight-tab"
            />
          </div>
        </div>
        {introduction.length > 0 && (
          <div class="page-grid-description flex flex-col">
            {introduction.map((paragraph) => (
              <p class="text-lg md:text-xl leading-normal text-primary mb-4 font-light">
                {paragraph}
              </p>
            ))}
            <a
              href="/work"
              class="text-lg md:text-xl w-fit md:mb-10 underline underline-offset-4 decoration-2"
            >
              &gt; Work
            </a>
          </div>
        )}
      </div>

      <div id="insight-all">
        <InsightGrid insights={insights} />
      </div>

      {
        filterTypes.slice(1).map((type) => (
          <div id={`insight-${type}`} class="hidden">
            <InsightGrid
              insights={insights.filter(
                (i: { type: string }) => i.type === type
              )}
            />
          </div>
        ))
      }
    </div>
  </section>

  <script is:inline type="module" src="/scripts/insightTabs.js"></script>
</BaseLayout>
