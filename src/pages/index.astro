---
import BaseLayout from "../layouts/BaseLayout.astro";
import VisitorLanding from "../components/VisitorLanding.astro";
import HomeProjectTile from "../components/HomeProjectTile.astro";

import { sanity } from "../lib/sanityClient";
import { getHomePageQuery } from "../lib/queries";
import { normaliseText } from "../utils/normaliseText";
import { homeProjectCandidates, homeProjectTiles } from "../lib/projects";
import type { Project } from "../types/Project";
import {
  resolveSeoTitle,
  resolveSeoDescription,
  resolveSeoImage,
  SITE_TITLE_SUFFIX,
} from "../lib/seo";

const home = await sanity.fetch(getHomePageQuery);

// Featured link (fallback to /studio)
const featuredHref = home?.featuredPage?.pageSlug
  ? `/${home.featuredPage.pageSlug.replace(/^\/+/, "")}`
  : "/studio";
const featuredLabel = home?.featuredPage?.pageTitle || "Studio";

const items = homeProjectTiles(home?.projectTiles);
const mediaProjects = homeProjectCandidates<Project>(home?.mediaProjects).filter((project) =>
  project.heroImage?.asset?.url || project.imageUrl
);
const postcodeProjects = homeProjectCandidates<{ _id: string; postCode: string }>(home?.postcodeProjects);

// Normalise intro text
const introRaw = home?.intro ?? "";
const intro = normaliseText(introRaw);
const introText = intro.join(" ");

const metaTitle = resolveSeoTitle(home?.seo?.metaTitle, `${SITE_TITLE_SUFFIX} | RIBA Chartered Practice`);
const metaDescription = resolveSeoDescription(
  home?.seo?.metaDescription,
  introText,
  "Sustainable architecture across urban, inter-urban and rural contexts by Butcher Bayley Architects."
);
const ogImage = resolveSeoImage(home?.seo?.ogImage);
---

<BaseLayout
  mainClass="page-grid-main page-grid-main--md"
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImage}
  breadcrumbs={[{ name: "Home", path: "/" }]}
>
  <VisitorLanding slot="landing" content={home} />
  <div
    class="home-frame site-frame flex md:flex-row flex-col-reverse page-header-min-screen"
  >
    <!-- Left: Grid -->

    <div class="w-full md:w-1/2" data-home-projects>
      <div class="home-project-grid image-grid grid grid-cols-2">
        {
          Array.from({ length: 12 }, (_, index) => {
            const slotType = index % 4 === 1 || index % 4 === 2 ? "media" : "postcode";
            const item = items[index];
            return <HomeProjectTile
              label={item?.label ?? ""}
              project={item?.project}
              media={slotType === "media" && item?.media}
              slotType={slotType}
            />;
          })
        }
      </div>
      {mediaProjects.map((project) => (
        <template data-home-media data-project-id={project._id} data-project-type={project.type ?? ""} data-postcode={project.postCode}>
          <HomeProjectTile label={project.postCode} project={project} media slotType="media" />
        </template>
      ))}
      <script is:inline type="application/json" data-home-postcodes set:html={JSON.stringify(postcodeProjects).replace(/</g, "\\u003c")} />
      <script is:inline>window.__bbaHomeGrid?.initialise(document);</script>
    </div>

    <!-- Right: Copy -->
    <div
      class="w-full md:w-1/2 md:max-w-[800px] flex flex-col px-4 md:px-8 md:sticky md:top-0 self-start page-header-clearance page-header-clearance--home"
    >
      <h1 class="font-future text-2xl md:text-4xl text-primary mb-4">
        {home?.title ?? "BBA is an inter-urban studio."}
      </h1>
      {
        intro.map((para: string) => (
          <p class="text-lg md:text-xl text-primary font-light break-words mb-4 whitespace-normal">
            {para.replace(/\n+/g, " ")}
          </p>
        ))
      }
      <a
        href={featuredHref}
        class="text-lg md:text-xl relative group w-fit mb-10"
      >
        &gt; {featuredLabel}
        <span
          class="hidden lg:block absolute left-0 -bottom-1 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full"
        ></span>
      </a>
    </div>
  </div>
</BaseLayout>
