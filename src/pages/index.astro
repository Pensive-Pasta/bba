---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import HoldingPageContent from "../components/HoldingPageContent.astro";
import HoldingLayout from "../layouts/HoldingLayout.astro";

const holdingImageModules = import.meta.glob("../assets/holding/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
  import: "default",
});

const holdingSlides = Object.entries(holdingImageModules)
  .sort(([left], [right]) => left.localeCompare(right))
  .map(([path, image]) => {
    const filename = path.split("/").pop() ?? "holding image";
    const baseName = filename.replace(/\.[^.]+$/, "");
    const humanLabel = baseName
      .replace(/^[0-9_-]+/, "")
      .replace(/[-_]+/g, " ")
      .trim();

    return {
      path,
      image: image as ImageMetadata,
      alt: humanLabel
        ? `${humanLabel} by Butcher Bayley Architects`
        : "Butcher Bayley Architects project image",
    };
  });

const firstSlidePreload = holdingSlides[0]
  ? await getImage({
      src: holdingSlides[0].image,
      width: 1600,
      format: "webp",
    })
  : undefined;

const metaTitle = "Butcher Bayley Architects | New website coming soon";
const metaDescription =
  "A new Butcher Bayley Architects website is coming soon. In the meantime, view the project archive or contact the studio directly.";
const ogImage = firstSlidePreload?.src;
---

<HoldingLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImage}
  preloadImageHref={firstSlidePreload?.src}
>
  <HoldingPageContent />
</HoldingLayout>
