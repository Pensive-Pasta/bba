---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Seo from "../components/Seo.astro";
import { SITE_NAME, DEFAULT_SEO_IMAGE } from "../lib/seo";
import theFutureRegularUrl from "../assets/fonts/the-future-regular.woff2";

const {
  title,
  description,
  ogType,
  ogImage,
  robots,
  jsonLd,
  breadcrumbs = [],
} = Astro.props;

const siteOrigin = Astro.site?.toString();

if (!siteOrigin) {
  throw new Error(
    "Astro.site is required for SEO metadata. Set `site` in astro.config.mjs."
  );
}

const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const normalizedSiteOrigin = siteOrigin.replace(/\/$/, "");
const resolvedOgImage =
  ogImage
    ? new URL(ogImage, siteOrigin).toString()
    : new URL(DEFAULT_SEO_IMAGE, siteOrigin).toString();

const organizationId = `${normalizedSiteOrigin}/#organization`;
const websiteId = `${normalizedSiteOrigin}/#website`;

const globalJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    url: normalizedSiteOrigin,
    name: SITE_NAME,
    publisher: {
      "@id": organizationId,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": organizationId,
    name: SITE_NAME,
    alternateName: "BBA",
    url: normalizedSiteOrigin,
    logo: new URL("/images/BBA-Logo.png", normalizedSiteOrigin).toString(),
    email: "hello@wearebba.co.uk",
  },
];

const breadcrumbJsonLd =
  breadcrumbs.length > 1
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map(
          (item: { name: string; path: string }, index: number) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.name,
            item: new URL(item.path, normalizedSiteOrigin).toString(),
          })
        ),
      }
    : undefined;

const pageJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const structuredData = [
  ...globalJsonLd,
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...pageJsonLd,
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <Seo
      title={title}
      description={description}
      ogType={ogType}
      ogImage={resolvedOgImage}
      canonical={canonical}
      siteOrigin={siteOrigin}
      robots={robots}
      jsonLd={structuredData}
    />
    <link
      rel="preload"
      href={theFutureRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin
    /></head
  >

  <ClientRouter />

  <body class="w-full min-h-screen bg-white flex flex-col">
    <main>
      <slot />
    </main>
  </body>
</html>
